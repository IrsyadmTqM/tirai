{
  "name": "tirai",
  "version": "1.0.0",
  "description": "Tirai: aplikasi ZISWAF privacy-first (tugas besar ICT dan Islam)",
  "scripts": {
    "dev": "concurrently -n server,web -c green,blue \"node --disable-warning=ExperimentalWarning --watch --env-file-if-exists=.env src/server/index.js\" \"vite\"",
    "build": "vite build",
    "start": "node --disable-warning=ExperimentalWarning --env-file-if-exists=.env src/server/index.js",
    "test": "vitest run",
    "db:reset": "node --disable-warning=ExperimentalWarning --env-file-if-exists=.env scripts/db-reset.js",
    "db:lihat": "node --disable-warning=ExperimentalWarning --env-file-if-exists=.env scripts/lihat-database.js",
    "docs:inventaris": "node scripts/tulis-inventaris.js"
  },
  "author": "",
  "license": "MIT",
  "dependencies": {
    "express": "^5.3.0"
  },
  "devDependencies": {
    "@fontsource/atkinson-hyperlegible": "^5.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "supertest": "^7.3.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.2"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  }
}
