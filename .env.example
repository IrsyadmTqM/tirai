# Salin berkas ini menjadi .env lalu isi nilainya. Jangan commit .env.
PORT=3000

# Opsional. Lokasi berkas database SQLite (harus berakhiran .db).
# Bawaan: data/tirai.db. Berkas ini dibuat ulang setiap server menyala.
# DB_PATH=data/tirai.db

# Opsional. Buku kas peragaan di beranda (tanpa masuk) hanya pantas untuk data sintetis.
# Isi "mati" untuk pemasangan dengan data sungguhan.
# MODE_PERAGAAN=mati

# Kunci master untuk membungkus kunci data (envelope encryption), 32 byte dalam base64.
# Buat dengan: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Kosong: server memakai kunci sementara di memori (hanya untuk mencoba).
MASTER_KEY=

# Kunci HMAC untuk penanda duplikat NIK, 32 byte dalam base64. Harus berbeda dari MASTER_KEY.
NIK_HMAC_KEY=
