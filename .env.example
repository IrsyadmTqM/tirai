# Salin berkas ini menjadi .env lalu isi nilainya. Jangan commit .env.
PORT=3000

# Kunci master untuk membungkus kunci data (envelope encryption), 32 byte dalam base64.
# Buat dengan: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# (dipakai mulai langkah 3)
MASTER_KEY=

# Kunci HMAC untuk penanda duplikat NIK, 32 byte dalam base64. Harus berbeda dari MASTER_KEY.
# (dipakai mulai langkah 3)
NIK_HMAC_KEY=
